    "scratch-storage": "^1.1.0",
    "scratch-svg-renderer": "^0.2.0-prerelease.20210325225314",
    "scratch-vm": "^0.2.0-prerelease.20210510162256",
    "web-vitals": "^1.1.1"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
