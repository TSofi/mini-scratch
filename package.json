{
  "name": "mini-scratch",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "clsx": "^1.1.1",
    "lodash": "^4.17.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recoil": "^0.7.7",
    "scratch-audio": "0.1.0-prerelease.20200528195344",
    "scratch-render": "0.1.0-prerelease.20210325231800",
